{
  "collectionName": "components_cart_cart_items",
  "info": {
    "displayName": "Cart Item",
    "description": "Individual item in cart or order"
  },
  "options": {},
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "quantity": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "color": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "subtotal": {
      "type": "decimal"
    }
  }
}
