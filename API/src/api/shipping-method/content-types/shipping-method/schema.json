{
  "kind": "collectionType",
  "collectionName": "shipping_methods",
  "info": {
    "singularName": "shipping-method",
    "pluralName": "shipping-methods",
    "displayName": "Shipping Method",
    "description": "Available shipping options"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "carrier": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "estimatedDays": {
      "type": "string"
    },
    "freeShippingThreshold": {
      "type": "decimal"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
