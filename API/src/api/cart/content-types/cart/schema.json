{
  "kind": "collectionType",
  "collectionName": "carts",
  "info": {
    "singularName": "cart",
    "pluralName": "carts",
    "displayName": "Cart",
    "description": "User shopping cart"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "cart.cart-item"
    },
    "totalAmount": {
      "type": "decimal",
      "default": 0
    },
    "totalItems": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "abandoned",
        "checked_out"
      ],
      "default": "active"
    },
    "couponCode": {
      "type": "string"
    },
    "discount": {
      "type": "decimal",
      "default": 0
    },
    "taxAmount": {
      "type": "decimal",
      "default": 0
    },
    "shippingCost": {
      "type": "decimal",
      "default": 0
    },
    "finalTotal": {
      "type": "decimal",
      "default": 0
    },
    "expiresAt": {
      "type": "datetime"
    },
    "sessionId": {
      "type": "string"
    }
  }
}
